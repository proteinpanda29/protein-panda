# Required for the app to actually work — point this at your real
# deployed backend URL, not localhost, once you're not running locally.
NEXT_PUBLIC_API_URL="http://localhost:4000/api"

# Required for correct SEO metadata (sitemap.xml, robots.txt, canonical
# URLs, OpenGraph tags) — set to your real public domain once you have
# one. Falls back to localhost, which is fine for local dev but wrong
# in any real deployment.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Everything below is optional — see frontend/src/lib/siteConfig.ts
# and REBRANDING.md for the full picture. Sensible defaults apply if
# you don't set these. ---
NEXT_PUBLIC_BUSINESS_NAME="Protein Panda"
NEXT_PUBLIC_TAGLINE="Fuel your gains, one shake at a time."
NEXT_PUBLIC_MASCOT_EMOJI="🐼"
NEXT_PUBLIC_CURRENCY_SYMBOL="₹"
NEXT_PUBLIC_ASSISTANT_NAME="Panda Assistant"
NEXT_PUBLIC_PRIMARY_COLOR_HEX="#6F8615"
# Same real value as the backend's GOOGLE_CLIENT_ID — this one is meant
# to be public (it's sent to the browser either way for GIS to use).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
