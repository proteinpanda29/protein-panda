DATABASE_URL="postgresql://postgres:postgres@localhost:5432/protein_panda?schema=public"
# Also used by the rate limiter's storage backend, if set — see the
# concurrent-login notes below. Not required; both the leaderboard cache
# and the rate limiter fall back to safe defaults without it.
REDIS_URL="redis://localhost:6379"
# Also backs the invoice-email job queue (BullMQ) — see
# backend/src/queue/. Without Redis reachable at all, invoice emails
# still send (falls back to the old direct-call behavior), just without
# retries/durability. A worker process needs to be running for queued
# jobs to actually process — the same `npm run start:dev` process runs
# both the API and the worker together (NotificationProcessor is
# registered in the same Nest app), so no separate worker process is
# needed for this app's current scale.
JWT_SECRET="change-me-to-a-long-random-string"
FRONTEND_URL="http://localhost:3000"
PORT=4000

# --- Concurrent-login throughput tuning (optional — sensible defaults
# apply automatically if you don't set these) ---
#
# Node's bcrypt calls run on a small worker-thread pool, default size 4
# — meaning only ~4 login verifications can genuinely run in parallel
# at once, regardless of how much CPU the machine actually has. Raising
# this lets more logins process simultaneously under real concurrent
# load. Must be set before Node starts (can't be changed from within
# the app's own code — libuv reads it once at startup).
UV_THREADPOOL_SIZE=8

# Prisma's default database connection pool size is small and generic.
# Under concurrent load, requests queue up waiting for a free connection
# once the pool is exhausted. Raise this if you're expecting many
# simultaneous logins/orders — appended directly to DATABASE_URL above,
# e.g.: postgresql://...db?connection_limit=15

# Razorpay (get from https://dashboard.razorpay.com/app/keys — use test mode keys for development)
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"
# Separate secret for the server-to-server webhook (not the same as
# RAZORPAY_KEY_SECRET above). Set up in the Razorpay Dashboard under
# Settings > Webhooks: point it at https://yourdomain.com/api/payments/webhook,
# subscribe to BOTH "payment.captured" (online checkout) AND
# "payment_link.paid" (POS/counter-sale UPI, via a scannable QR code) —
# without the second one, in-person UPI sales will never confirm as
# paid. This is what reconciles a payment even if the customer's
# browser/phone closes right after paying — without it, only the
# less-reliable in-browser callback confirms payments.
RAZORPAY_WEBHOOK_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"

# AI Nutrition Assistant (get an API key from https://console.anthropic.com)
# NOT free — pay-per-token, billed to whoever owns this key. No ongoing
# free API tier exists (new accounts get a small one-time trial credit).
# Cost per customer message is small (a fraction of a cent), but it scales
# with usage — if reselling this app, the shop owner needs their own key
# and should know it's a running cost, not a one-time fee.
GEMINI_API_KEY="AIzaSy-xxxxxxxxxxxxxxxxxxxx"

# Product image uploads (Cloudinary — real product photos, not just a
# typed-in URL). Free tier is genuinely enough for a single shop's
# catalog. Get these from cloudinary.com → Dashboard, right after
# signup — no separate "upload preset" setup needed, since this uses
# signed uploads (admin-only, generated per-upload by this backend)
# rather than a public unsigned preset.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Google Sign-In. Get from console.cloud.google.com -> APIs & Services
# -> Credentials -> Create OAuth client ID (Web application) -> add your
# real site URL under "Authorized JavaScript origins". Same value goes
# in the frontend's NEXT_PUBLIC_GOOGLE_CLIENT_ID (it's meant to be
# public — it's not a secret, just an identifier).
GOOGLE_CLIENT_ID=""

# Push notifications (real browser push, not the same thing as
# WhatsApp/SMS/email above). Generate a real key pair once with:
#   npx web-push generate-vapid-keys
# The public key also needs to go in the frontend as
# NEXT_PUBLIC_VAPID_PUBLIC_KEY — it's meant to be public, not a secret.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_CONTACT_EMAIL=""

# OTP delivery — real email + SMS for login/signup codes.
# Without these, OTPs still work locally: they're printed to the backend
# terminal as "[DEV FALLBACK] OTP for ...: 123456" so testing never blocks.

# --- RECOMMENDED if you're hosting on Railway (or most cloud platforms):
# Zoho ZeptoMail's HTTPS API — NOT the SMTP option further below.
# Confirmed via a real deployment: raw SMTP (ports 25/465/587) is
# blocked/throttled on Railway as an anti-spam measure, and fails with
# a bare "Connection timeout" — not a credentials error — regardless of
# how correctly Gmail/SMTP is configured. This sends over HTTPS (port
# 443, the same port normal web traffic uses) instead, which isn't
# subject to that restriction.
#   1. zoho.com/zeptomail -> sign up -> create an Agent
#   2. Agent -> SMTP/API -> API tab -> copy the "Send Mail Token"
ZEPTOMAIL_API_TOKEN=""
ZEPTOMAIL_FROM_EMAIL=""

# --- Email via Gmail SMTP — works fine locally/on a VPS, but likely
# will NOT work on Railway specifically (see above).
# 1. Turn on 2-Step Verification on your Gmail account (myaccount.google.com/security)
# 2. Create an "App Password" at myaccount.google.com/apppasswords
#    (NOT your normal Gmail password — Google blocks that for security)
GMAIL_USER="yourshop@gmail.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"

# --- OR: any other real SMTP provider (SendGrid, Amazon SES, etc.) via
# raw SMTP — same Railway-blocks-SMTP caveat as Gmail above applies here
# too. Priority order when multiple are set: ZeptoMail API, then this,
# then Gmail.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# SMS via MSG91 — IMPORTANT: sending transactional SMS to Indian numbers
# legally requires DLT (Distributed Ledger Technology) registration first:
# 1. Register as a business entity + register a Sender ID (e.g. "PRTPND")
#    on your telecom's DLT portal, or via MSG91's own DLT onboarding at
#    https://msg91.com/dlt — this is a multi-day approval process, not
#    an instant signup.
# 2. Get your MSG91 auth key from https://control.msg91.com/app/dashboard
# 3. Get the approved DLT template ID for your OTP message from MSG91
#    after your template is approved.
# Until both are set, SMS OTPs fall back to the dev console log above.
MSG91_AUTH_KEY=""
MSG91_DLT_TEMPLATE_ID=""

# --- WhatsApp order-status notifications via MSG91's WhatsApp Business
# API (a separate product from SMS above, same MSG91 account). See
# backend/src/queue/whatsapp.service.ts for an important caveat: the
# exact request format is a best-effort placeholder pending your real
# dashboard's API example for your specific approved template — the
# queue/retry/fallback infrastructure around it is done and tested,
# this one piece needs a final check against your real MSG91 response.
#   1. MSG91 dashboard -> Settings -> WhatsApp -> request access
#   2. Create + submit a template (e.g. "order_confirmed") for approval
#      (24-48 hour turnaround)
#   3. Once approved, MSG91 shows a real API example — use it to
#      confirm/correct the request in whatsapp.service.ts
WHATSAPP_AUTH_KEY=""
WHATSAPP_INTEGRATED_NUMBER=""
WHATSAPP_TEMPLATE_ORDER_CONFIRMED=""

